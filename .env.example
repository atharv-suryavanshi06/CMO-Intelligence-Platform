# ============================================================
# Core API Configuration
# ============================================================

GOOGLE_API_KEY=your_google_api_key
RAG_API_AUTH_TOKEN=your_rag_api_auth_token

RAG_API_USERNAME=your_username
RAG_API_PASSWORD=your_password

DEEPGRAM_API_KEY=your_deepgram_api_key
TAVILY_API_KEY=your_tavily_api_key
VIRUSTOTAL_API_KEY=your_virustotal_api_key
LAKERA_GUARD_API_KEY=your_lakera_guard_api_key


# ============================================================
# Database
# ============================================================

RAG_DATABASE_URL=postgresql://username:password@localhost:5432/database_name


# ============================================================
# LangSmith
# ============================================================

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
RAG_ENVIRONMENT=development
LANGSMITH_TRACING_SAMPLING_RATE=1.0
LANGSMITH_PROJECT=your_langsmith_project_name


# ============================================================
# CMO API -> Presenton Connection
# ============================================================

PRESENTON_BASE_URL=https://api.presenton.ai
PRESENTON_API_KEY=your_presenton_api_key
PRESENTON_TIMEOUT_SECONDS=120


# ============================================================
# Presenton Docker / Container Environment
# ============================================================
# These variables belong to the Presenton Docker/container
# environment, not the CMO API process.
# Keep GOOGLE_API_KEY server-side in Presenton.

LLM=google
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MODEL=models/gemini-2.0-flash
WEB_GROUNDING=false
CAN_CHANGE_KEYS=false